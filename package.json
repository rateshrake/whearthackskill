{
  "name": "vayushield",
  "version": "1.0.0",
  "private": true,
  "description": "VayuShield: Deterministic Physics & Air Quality Index Kernel for Delhi-NCR & Global Exposure Optimization",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node -e \"const fs=require('fs'),cp=require('child_process');if(fs.existsSync('public'))fs.cpSync('public','.next/standalone/public',{recursive:true,force:true});if(fs.existsSync('.next/static'))fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true,force:true});cp.execFileSync(process.execPath,['.next/standalone/server.js'],{stdio:'inherit',env:{...process.env,PORT:process.env.PORT||'3000',HOSTNAME:process.env.HOSTNAME||'127.0.0.1'}});\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\" \"e2e/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "overrides": {
    "tinypool": "^2.2.0",
    "next": {
      "postcss": "^8.5.33"
    }
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/eslint-plugin-next": "^15.5.29",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "prettier": "^3.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
